RewriteEngine On

RewriteBase /ads-oauth/
ErrorDocument 404 /ads-oauth/404.html

RewriteRule ^\.well-known/acme-challenge - [L]
RewriteRule "(^|/)\." - [F]

# PROMPT-22: bin/ yalnizca sunucuda CLI kullanimi icindir; web erisimi yasak.
RewriteRule ^bin/ - [F,L]

#RewriteCond %{HTTPS} off
#RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]